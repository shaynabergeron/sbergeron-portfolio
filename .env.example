# REQUIRED for contact form submissions.
# Get a key from Resend after adding and verifying a sending domain.
RESEND_API_KEY=re_replace_with_your_api_key
# Must be a verified sender address on your Resend domain.
RESEND_FROM_EMAIL="Portfolio Contact <hello@your-verified-domain.com>"

# Optional: public, canonical domain for OG image URLs and sharing.
# If you add a custom domain in Netlify, update this to match it.
# For the default https://shayna-bergeron-portfolio.netlify.app domain, omit it.
# SITE_URL=https://shayna-bergeron-portfolio.netlify.app
